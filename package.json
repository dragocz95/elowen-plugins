{
  "name": "elowen-plugins-registry",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:node && npm run test:ui",
    "test:node": "node --test --import=./tests/register-loader.mjs \"tests/*.test.mjs\"",
    "test:ui": "vitest run",
    "test:e2e": "npm run test:e2e:msteams && npm run test:e2e:telegram && npm run test:e2e:whatsapp && npm run test:e2e:discord",
    "test:e2e:msteams": "node tests/e2e/msteams/run.mjs",
    "build:web": "node scripts/build-web.mjs",
    "check:web": "node scripts/build-web.mjs && git diff --exit-code -- \"plugins/*/web/index.js\"",
    "check": "npm run check:web && npm test",
    "test:e2e:telegram": "node tests/e2e/telegram/run.mjs",
    "test:e2e:whatsapp": "node tests/e2e/whatsapp/run.mjs",
    "test:e2e:discord": "node tests/e2e/discord/run.mjs"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "baileys": "^7.0.0-rc13",
    "better-sqlite3": "^13.0.3",
    "elowen": "^0.28.1",
    "elowen-plugin-shared": "^0.1.0",
    "elowen-plugin-ui-kit": "^0.1.0",
    "grammy": "^1.45.1",
    "jose": "^5.10.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.460.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
