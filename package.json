{
  "name": "elowen-plugins-registry",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deadcode": "knip",
    "depcruise": "depcruise plugins scripts tests --config .dependency-cruiser.cjs",
    "languages-check": "node scripts/check-languages.mjs",
    "manifest-check": "node scripts/check-manifests.mjs",
    "release:plugin": "node scripts/release-plugin.mjs",
    "shared-check": "node scripts/check-shared-compat.mjs",
    "typecheck": "tsc -p tsconfig.plugins.json --noEmit && tsc -p tsconfig.plugins-web.json --noEmit",
    "test": "npm run test:node && npm run test:ui",
    "test:node": "node --test --import=./tests/register-loader.mjs \"tests/*.test.mjs\"",
    "test:ui": "vitest run",
    "test:e2e": "npm run test:e2e:msteams && npm run test:e2e:telegram && npm run test:e2e:whatsapp && npm run test:e2e:discord && npm run test:e2e:cron",
    "test:e2e:msteams": "node tests/e2e/msteams/run.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:ts": "node scripts/build-ts.mjs",
    "check:web": "node scripts/build-web.mjs && git diff --exit-code -- \"plugins/*/web/index.*\"",
    "check:dist": "node scripts/build-ts.mjs && git diff --exit-code -- \"plugins/*/dist/*\"",
    "check": "npm run lint && npm run deadcode && npm run depcruise && npm run typecheck && npm run languages-check && npm run shared-check && npm run manifest-check",
    "test:e2e:telegram": "node tests/e2e/telegram/run.mjs",
    "test:e2e:whatsapp": "node tests/e2e/whatsapp/run.mjs",
    "test:e2e:discord": "node tests/e2e/discord/run.mjs",
    "test:e2e:cron": "node tests/e2e/cron/run.mjs",
    "check:web-types": "tsc -p tsconfig.plugins-web.json"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/oxide": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "baileys": "^7.0.0-rc13",
    "better-sqlite3": "^11.0.0",
    "botframework-connector": "^4.23.3",
    "dependency-cruiser": "^17.4.3",
    "dompurify": "^3.4.13",
    "elowen": "^0.28.17",
    "elowen-plugin-shared": "^0.1.7",
    "elowen-plugin-ui-kit": "^0.6.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "grammy": "^1.45.1",
    "jose": "^5.10.0",
    "jsdom": "^25.0.1",
    "knip": "^6.32.3",
    "lucide-react": "^0.460.0",
    "marked": "^18.0.7",
    "papaparse": "^5.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.8.5",
    "typebox": "^1.1.38",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.10",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
