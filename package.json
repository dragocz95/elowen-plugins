{
  "name": "elowen-plugins-registry",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:node && npm run test:ui",
    "test:node": "node --test --import=./tests/register-loader.mjs",
    "test:ui": "vitest run",
    "build:web": "node scripts/build-web.mjs",
    "check:web": "node scripts/build-web.mjs && git diff --exit-code -- \"plugins/*/web/index.js\"",
    "check": "npm run check:web && npm test"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "better-sqlite3": "^13.0.3",
    "elowen-plugin-shared": "^0.1.0",
    "elowen-plugin-ui-kit": "^0.1.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.460.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
