{
  "name": "skills",
  "version": "0.4.2",
  "apiVersion": "1",
  "requiresCore": "0.28.48",
  "description": "Loads markdown skills from disk and exposes them to the Elowen brain.",
  "entry": "index.mjs",
  "provides": {
    "skills": [
      "*"
    ],
    "tools": [
      "SkillLoad",
      "CreateSkill",
      "ListSkills",
      "DeleteSkill"
    ],
    "readOnlyTools": ["SkillLoad", "ListSkills"],
    "apiRoutes": [
      "/plugins/skills",
      "/plugins/skills/list",
      "/plugins/skills/accounts",
      "/plugins/skills/plugin-availability",
      "/plugins/skills/:name",
      "/plugins/skills/:name/owner"
    ]
  },
  "userGrantable": true,
  "capabilities": {
    "mutates": ["turnContext"],
    "reads": [
      "stores",
      "controls"
    ]
  },
  "consumesControls": ["skillCatalog"],
  "deferLoading": [
    "CreateSkill",
    "DeleteSkill"
  ],
  "icons": {
    "SkillLoad": "📚",
    "CreateSkill": "📖",
    "ListSkills": "📖",
    "DeleteSkill": "📖"
  },
  "planSafe": [
    "SkillLoad",
    "ListSkills"
  ],
  "web": {
    "entry": "web/index.js",
    "css": "web/index.css",
    "requiresApiVersion": 8,
    "chatPickers": true,
    "settings": [
      {
        "id": "skills",
        "label": "Skills",
        "icon": "GraduationCap"
      }
    ],
    "strings": {
      "title": "Skills",
      "sectionHint": "Reusable instructions injected into the system prompt. Apply to new conversations.",
      "empty": "No skills yet.",
      "badgeBundled": "bundled",
      "badgeProvided": "provided",
      "badgeUser": "custom",
      "add": "Add skill",
      "edit": "Edit skill",
      "remove": "Delete skill",
      "deleteTitle": "Delete skill",
      "deleteDesc": "The skill “{name}” will be removed permanently.",
      "name": "Name",
      "description": "Description",
      "content": "Content",
      "save": "Save skill",
      "cancel": "Cancel",
      "created": "Skill saved",
      "updated": "Skill updated",
      "deleted": "Skill deleted",
      "disableModelInvocation": "Use automatically",
      "disableModelInvocationHint": "On: the model can select this skill automatically. Off: it stays available only via /skill:name.",
      "manualOnlyBadge": "manual only",
      "helpName": "kebab-case: lowercase letters, digits and dashes (e.g. “deploy-checklist”).",
      "helpDescription": "One line: when the assistant should use this skill.",
      "helpContent": "The skill body — markdown instructions for the assistant.",
      "ownerColumn": "Owner",
      "ownerInstance": "Everyone",
      "ownerMine": "Mine",
      "scopeMine": "Mine",
      "scopeInstance": "Instance",
      "scopeBundled": "Bundled",
      "scopePlugin": "Plugin",
      "accountLabel": "Account",
      "accountHint": "Choose the account whose effective skill catalog you want to review.",
      "pluginAvailability": "Available for this account",
      "statusEffective": "Effective",
      "statusDisabled": "Disabled for account",
      "statusUnavailable": "Plugin unavailable or not granted",
      "statusShadowed": "Shadowed by precedence",
      "scopeFieldLabel": "Visible to",
      "scopeFieldPersonal": "Only me",
      "scopeFieldInstance": "Everyone",
      "scopeFieldHint": "A personal skill is loaded only into your own conversations. An instance skill is loaded into everyone’s.",
      "scopeMoveHint": "Changing this moves the skill file to the other set.",
      "workspaceEyebrow": "Skills",
      "workspaceReady": "Skills loaded",
      "pickerTitle": "Skills",
      "pickerFilter": "Filter skills",
      "pickerLoad": "Load into conversation",
      "pickerDelete": "Delete skill",
      "pickerEmpty": "No skills",
