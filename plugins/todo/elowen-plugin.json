{
  "name": "todo",
  "version": "0.14.20",
  "apiVersion": "2",
  "requiresCore": "0.28.53",
  "description": "Session task list: the agent tracks multi-step work incrementally and shows progress live.",
  "entry": "index.mjs",
  "capabilities": {
    "reads": [
      "db"
    ]
  },
  "provides": {
    "tools": [
      "TaskCreate",
      "TaskGet",
      "TaskUpdate",
      "TaskDelete",
      "TaskList"
    ],
    "readOnlyTools": [
      "TaskGet",
      "TaskList"
    ],
    "apiRoutes": [
      "tasks",
      "task"
    ]
  },
  "planSafe": [
    "TaskGet",
    "TaskList"
  ],
  "web": {
    "entry": "web/index.js",
    "css": "web/index.css",
    "requiresApiVersion": 18,
    "chatPickers": true,
    "chatCards": true,
    "chatRailSections": true,
    "strings": {
      "title": "Tasks",
      "filter": "Filter tasks",
      "pending": "Pending",
      "inProgress": "In progress",
      "completed": "Completed",
      "blocked": "Waiting for",
      "rename": "Rename",
      "delete": "Delete",
      "actions": "Task actions",
      "open": "Open task list",
      "clearCompleted": "Clear completed",
      "clearAll": "Clear all",
      "deleteTitle": "Delete this task?",
      "clearCompletedTitle": "Clear completed tasks?",
      "clearCompletedDesc": "Completed tasks will be permanently removed.",
      "clearAllTitle": "Clear all tasks?",
      "clearAllDesc": "All tasks will be permanently removed.",
      "empty": "No tasks",
      "emptyDesc": "No tasks in this conversation.",
      "unavailable": "The todo plugin is unavailable.",
      "railTitle": "Tasks",
      "more": "more"
    }
  },
  "icons": {
    "Task*": "📋"
  }
}
