{
  "name": "github",
  "version": "0.1.1",
  "apiVersion": "1",
  "requiresCore": "0.28.12",
  "description": "Account-scoped GitHub App integration for repository mappings, secure Sandbox branch publishing, pull requests, reviews, checks and explicitly confirmed merges.",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "provides": {
    "tools": [
      "GithubConnectionStatus",
      "GithubRepositoryStatus",
      "GithubListPullRequests",
      "GithubGetPullRequest",
      "GithubPullRequestChecks",
      "GithubPublishBranch",
      "GithubCreatePullRequest",
      "GithubSubmitReview",
      "GithubMergePullRequest"
    ],
    "apiRoutes": [
      "setup",
      "setup/secret",
      "status",
      "auth/start",
      "auth/callback",
      "test",
      "repositories",
      "repositories/detect",
      "repositories/map",
      "pull-requests",
      "pull-request",
      "checks",
      "actions/preview",
      "actions/confirm"
    ]
  },
  "icons": {
    "GithubConnectionStatus": "🐙",
    "GithubRepositoryStatus": "📦",
    "GithubListPullRequests": "🔀",
    "GithubGetPullRequest": "🔎",
    "GithubPullRequestChecks": "✅",
    "GithubPublishBranch": "⬆️",
    "GithubCreatePullRequest": "🌿",
    "GithubSubmitReview": "📝",
    "GithubMergePullRequest": "🔀"
  },
  "showOutput": ["GithubConnectionStatus", "GithubRepositoryStatus", "GithubListPullRequests", "GithubGetPullRequest", "GithubPullRequestChecks", "GithubPublishBranch", "GithubCreatePullRequest", "GithubSubmitReview", "GithubMergePullRequest"],
  "planSafe": ["GithubConnectionStatus", "GithubRepositoryStatus", "GithubListPullRequests", "GithubGetPullRequest", "GithubPullRequestChecks"],
  "deferLoading": ["Github*"],
  "capabilities": {
    "reads": ["db", "stores", "git", "controls"],
    "network": true
  },
  "configSchema": [
    { "key": "sec_app", "label": "GitHub App", "type": "section", "hint": "Configure the GitHub App used by this Elowen installation. Store the client secret from the GitHub page, not in this form." },
    { "key": "clientId", "label": "Client ID", "type": "text", "required": true, "hint": "The non-secret client ID of the GitHub App." },
    { "key": "appSlug", "label": "App slug", "type": "text", "required": true, "hint": "The public slug shown in the GitHub App URL." }
  ],
  "userConfigSchema": [
    { "key": "mergeMethod", "label": "Default merge method", "type": "select", "default": "squash", "options": [
      { "value": "squash", "label": "Squash" }, { "value": "merge", "label": "Merge commit" }, { "value": "rebase", "label": "Rebase" }
    ], "hint": "Used when a merge action does not explicitly select a method." }
  ],
  "web": {
    "entry": "web/index.js",
    "css": "web/index.css",
    "requiresApiVersion": 4,
    "account": [{ "id": "connection", "label": "GitHub", "icon": "Github" }],
    "project": [{ "id": "repository", "label": "GitHub", "icon": "Github" }],
    "strings": {
      "title": "GitHub",
