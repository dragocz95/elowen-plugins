{
  "name": "editor",
  "version": "0.3.2",
  "apiVersion": "1",
  "description": "Project file editor with Monaco, file management, previews for Markdown, images, PDF, media, Office and CSV files, a binary download fallback, and read-only Git history. Disabling it removes the editor UI and makes its grandfathered project-file API unavailable while project registration and task Git history remain available.",
  "entry": "dist/index.js",
  "capabilities": {
    "reads": [
      "stores",
      "project-files"
    ]
  },
  "provides": {
    "apiRoutes": [
      "/projects/:id/files",
      "/projects/:id/file",
      "/projects/:id/upload",
      "/projects/:id/raw",
      "/projects/:id/office-preview",
      "/projects/:id/new-file",
      "/projects/:id/dir",
      "/projects/:id/rename",
      "/projects/:id/copy",
      "/projects/:id/entry",
      "/projects/:id/diff",
      "/projects/:id/head",
      "/projects/:id/commit/:hash",
      "/projects/:id/commit/:hash/diff",
      "/projects/:id/commits",
      "/projects/:id/changed",
      "/projects/:id/changes"
    ]
  },
  "web": {
    "entry": "web/index.js",
    "css": "web/index.css",
    "requiresApiVersion": 8,
    "nav": [
      {
        "label": "Editor",
        "icon": "Code2",
        "route": ""
      }
    ],
    "strings": {
      "title": "Editor",
      "project": "Project",
      "empty": "No available project",
      "workspaceEyebrow": "Code workspace",
      "workspaceReady": "{project} connected",
      "noProjects": "No project to edit",
      "noProjectsDescription": "Create a project first, then open it here in the editor.",
      "editorTitle": "Code editor",
      "tabEdit": "Edit",
      "tabDiff": "Diff",
      "tabPreview": "Preview",
      "noFiles": "No files",
